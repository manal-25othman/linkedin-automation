# ──────────────────────────────────────────────────────────────
# استدلال — متغيّرات البيئة
#
# انسخ هذا الملف إلى .env.local للتطوير، واضبط القيم نفسها في
# Vercel → Settings → Environment Variables عند النشر.
#
# قاعدة واحدة لا تُخالَف: كل متغيّر يبدأ بـNEXT_PUBLIC_ يصل إلى
# المتصفّح ويظهر في حزمة الجافاسكربت. أي مفتاح سرّي يجب ألّا يحمل
# هذه البادئة أبدًا.
# ──────────────────────────────────────────────────────────────

# ─── الهوية والنطاق (مطلوب قبل النشر) ─────────────────────────
# النطاق الحقيقي بلا شرطة مائلة في آخره. تُبنى عليه الروابط الأساسية
# وخريطة الموقع وصور المشاركة. لا تضع هنا نطاق معاينة Vercel.
NEXT_PUBLIC_SITE_URL=https://istidlal.ai

# ─── قناة التواصل (مطلوب لمراجعة أدسنس) ───────────────────────
# اضبط البريد، أو نموذج المراسلة أدناه، أو الاثنين. صفحة التواصل
# لا تعرض قناةً غير مضبوطة.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_EDITORIAL_EMAIL=

# نموذج المراسلة عبر Resend. المفتاح خادمي بحت.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ─── حسابات التواصل (اختياري) ─────────────────────────────────
# غير المضبوط لا يظهر في الذيل ولا في sameAs بالبيانات المهيكلة.
# لا تضع رابط حساب غير موجود.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TIKTOK_URL=

# ─── النشرة البريدية (اختياري) ────────────────────────────────
# نقطة استقبال المشتركين عند مزوّدك. خادمية: المتصفّح لا يعرف
# المزوّد ولا مفتاحه. ما دامت فارغة لا يُعرض نموذج الاشتراك أصلًا.
NEWSLETTER_ENDPOINT=
NEWSLETTER_API_KEY=

# ─── المساعد التحريري (اختياري) ───────────────────────────────
# مفتاح Anthropic. خادمي بحت — لا يحمل بادئة NEXT_PUBLIC_ ولا يُقرأ
# في أي مكوّن عميل. المساعد ينتج مسوّدات فقط ولا ينشر شيئًا.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# رمز تشغيلي يحمي /api/assistant من الاستهلاك العام. ولّده بـ:
#   openssl rand -base64 32
ASSISTANT_ACCESS_TOKEN=

# ─── القياس (اختياري، يُحمَّل بعد موافقة الكوكيز) ──────────────
NEXT_PUBLIC_GA4_ID=

# ─── أدسنس (اتركه فارغًا حتى يتمّ القبول فعلًا) ────────────────
# ما دام فارغًا تبقى مساحات الإعلان صامتة محجوزة الأبعاد،
# ولا يُحمَّل سكربت أدسنس إطلاقًا.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ─── المحرّر المدمج (اختياري) ─────────────────────────────────
# تطبيق GitHub OAuth لتسجيل الدخول إلى /admin بضغطة واحدة.
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
