# ==========================================
# معرفة AI — Ma3rifah AI
# انسخ هذا الملف إلى .env.local واملأ القيم
# لا تضع أي مفاتيح حقيقية في Git
# ==========================================

# --- Supabase ---
# من: Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# المفتاح العام. تسمّيه لوحة Supabase الحديثة "Publishable key" ويبدأ
# بـsb_publishable_ ، وكان اسمه سابقًا "anon key". القيمة واحدة.
# يُقبل هنا أيٌّ من الاسمين: NEXT_PUBLIC_SUPABASE_ANON_KEY أو
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# مفتاح الخدمة — تسمّيه اللوحة الحديثة "Secret key" (sb_secret_...).
# للاستخدام على الخادم فقط. لا يُعرض أبدًا في المتصفح.
# يُقبل أيٌّ من: SUPABASE_SERVICE_ROLE_KEY أو SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Claude API (Anthropic) ---
# من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# معرّف النموذج المستخدم لتوليد الإجابات
ANTHROPIC_MODEL=claude-opus-5
# مستوى الجهد: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# حد أقصى لرموز الإخراج. تنبيه: على claude-opus-5 التفكير مفعّل تلقائيًا،
# وهذا السقف يشمل (التفكير + نص الإجابة) معًا لا الإجابة وحدها. قيمة ضيقة
# تُبتر الإجابة في منتصفها. لا تنزل تحت 4000.
ANTHROPIC_MAX_OUTPUT_TOKENS=8000

# --- مزوّد التضمينات (Embeddings) ---
# Claude API لا يوفّر endpoint للتضمينات، لذا نستخدم مزوّدًا منفصلًا.
# القيم المدعومة: voyage | openai | local
# ملاحظة: "local" مزوّد حتمي (deterministic) للتطوير والعرض فقط،
# جودته أقل بكثير ولا يصلح للإنتاج.
EMBEDDINGS_PROVIDER=voyage

# أبعاد المتجه — يجب أن تطابق العمود vector(N) في قاعدة البيانات.
# القيمة الافتراضية 1024 تناسب voyage-3.5 و voyage-3.
EMBEDDINGS_DIMENSIONS=1024

# Voyage AI (موصى به — يدعم العربية بجودة عالية)
# من: https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# بديل: أي مزوّد متوافق مع OpenAI Embeddings API
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# --- إعدادات التطبيق ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=معرفة AI

# مفتاح داخلي لحماية مسارات المعالجة الخلفية (اختياري لكن موصى به)
# ولّده بـ: openssl rand -base64 32
INTERNAL_API_SECRET=

# --- بيانات العرض التجريبي (seed) ---
# كلمة مرور موحّدة لحسابات الشركة التجريبية
DEMO_USER_PASSWORD=Ma3rifah!Demo2026
SUPER_ADMIN_EMAIL=admin@ma3rifah.ai
SUPER_ADMIN_PASSWORD=
