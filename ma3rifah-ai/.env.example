# ==========================================
# معرفة AI — Ma3rifah AI
# انسخ هذا الملف إلى .env.local واملأ القيم
# لا تضع أي مفاتيح حقيقية في Git
# ==========================================

# --- Supabase ---
# من: Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# المفتاح العام. تسمّيه لوحة Supabase الحديثة "Publishable key" ويبدأ
# بـsb_publishable_ ، وكان اسمه سابقًا "anon key". القيمة واحدة.
# يُقبل هنا أيٌّ من الاسمين: NEXT_PUBLIC_SUPABASE_ANON_KEY أو
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# مفتاح الخدمة — تسمّيه اللوحة الحديثة "Secret key" (sb_secret_...).
# للاستخدام على الخادم فقط. لا يُعرض أبدًا في المتصفح.
# يُقبل أيٌّ من: SUPABASE_SERVICE_ROLE_KEY أو SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Claude API (Anthropic) ---
# من: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# معرّف النموذج المستخدم لتوليد الإجابات.
# القيم الثلاث أدناه هي ما تفترضه حسبة الهامش في docs/product/04-PRICING-STRATEGY.md.
# ورفعها يقلب الهامش سالبًا عند الاستهلاك الكامل — أي أن العميل الأكثر
# استعمالًا يصير الأكثر خسارةً. فلا تُرفع إلا بعد مراجعة الحصص والأسعار.
ANTHROPIC_MODEL=claude-sonnet-5
# مستوى الجهد: low | medium | high | xhigh | max
# والسؤال هنا استرجاعيّ لا استدلاليّ: النموذج يقرأ مقاطع ويجيب منها.
# فزيادة الجهد تزيد رموز الخرج (أغلى ما في الطلب) أكثر مما تزيد الدقة.
ANTHROPIC_EFFORT=low
# حد أقصى لرموز الإخراج. تنبيه: السقف يشمل (التفكير + نص الإجابة) معًا لا
# الإجابة وحدها، فالقيمة الضيقة جدًا يستهلكها التفكير فتُبتر الإجابة العربية
# في منتصفها بلا رسالة خطأ. و3000 مع الجهد low تترك متسعًا كافيًا.
ANTHROPIC_MAX_OUTPUT_TOKENS=3000

# --- مزوّد التضمينات (Embeddings) ---
# Claude API لا يوفّر endpoint للتضمينات، لذا نستخدم مزوّدًا منفصلًا.
# القيم المدعومة: voyage | openai | local
# ملاحظة: "local" مزوّد حتمي (deterministic) للتطوير والعرض فقط،
# جودته أقل بكثير ولا يصلح للإنتاج.
EMBEDDINGS_PROVIDER=voyage

# أبعاد المتجه — يجب أن تطابق العمود vector(N) في قاعدة البيانات.
# القيمة الافتراضية 1024 تناسب voyage-3.5 و voyage-3.
EMBEDDINGS_DIMENSIONS=1024

# Voyage AI (موصى به — يدعم العربية بجودة عالية)
# من: https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# بديل: أي مزوّد متوافق مع OpenAI Embeddings API
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# --- إعدادات التطبيق ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=معرفة AI

# --- زر واتساب العائم ---
# رقم دولي بلا + ولا مسافات، مثال للسعودية: 9665XXXXXXXX
# إن تُرك فارغًا يُخفى الزر تمامًا — زر يفتح رقمًا فارغًا أسوأ من غيابه.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# رسالة مبدئية اختيارية تُملأ تلقائيًا في واتساب
NEXT_PUBLIC_WHATSAPP_MESSAGE=

# مفتاح داخلي لحماية مسارات المعالجة الخلفية (اختياري لكن موصى به)
# ولّده بـ: openssl rand -base64 32
INTERNAL_API_SECRET=

# --- بيانات العرض التجريبي (seed) ---
# كلمة مرور موحّدة لحسابات الشركة التجريبية
DEMO_USER_PASSWORD=Ma3rifah!Demo2026
SUPER_ADMIN_EMAIL=admin@ma3rifah.ai
SUPER_ADMIN_PASSWORD=

# ---------- واتساب (اختياري) ----------
# القناة معطّلة ما لم تُضبط الأربعة معًا. التفاصيل في docs/WHATSAPP-SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# نص عشوائي تخترعه أنت، ويُطابَق مع ما تضعه في لوحة Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------
# بوابة الدفع — Moyasar
# ---------------------------------------------------------------------
# اختيارية: المنصة تعمل بدونها، ومسار الاشتراك وحده يتعطّل.
# المفاتيح من لوحة Moyasar ← Settings ← API Keys.
# ابدئي بمفاتيح الاختبار (sk_test_ / pk_test_) — تعمل ببطاقات وهمية
# ولا تحتاج سجلًا تجاريًا.
#
# ⚠ المفتاح السري لا يوضع أبدًا في متغير يبدأ بـNEXT_PUBLIC_
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=

# رمز مشترك تكتبينه أنتِ في لوحة Moyasar عند إنشاء الـwebhook،
# ويُرسَل مع كل نداء لإثبات أنه من Moyasar لا من غيرها.
# بدونه تُرفض كل النداءات — وهو المطلوب.
MOYASAR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# أمن الجلسات
# ---------------------------------------------------------------------
# سرّ توقيع ختم الجلسة. اختياري: يُشتقّ من SUPABASE_SERVICE_ROLE_KEY إن
# غاب. لكن ضبطه صراحةً أفضل — فتغيير مفتاح الخدمة عندها لا يُخرج كل
# المستخدمين دفعةً واحدة.
#
# ولّده بأمر: openssl rand -base64 32
SESSION_SECRET=

# وضع التسجيل: invite (الافتراضي) أو open
#
# «invite» يمنع إنشاء أي حساب بلا رمز دعوة صالح — وهو المطلوب في مرحلة
# التجربة: رابط التسجيل الذي يُشارَك في مجموعة لا يفتح شيئًا.
#
# والافتراضي مغلق: متغيّر غائب أو مكتوب خطأً يعني «بدعوة». اتركيه كما هو
# حتى تقرّري فتح التسجيل للعامّة.
REGISTRATION_MODE=invite
