# قاعدة البيانات — PostgreSQL
# DATABASE_URL: اتصال التطبيق (على Vercel/Neon استخدم رابط الـ pooler)
# DIRECT_URL: اتصال مباشر للهجرات فقط. محليًا اجعل القيمتين متطابقتين.
DATABASE_URL="postgresql://user:pass@localhost:5432/anjez?schema=public"
DIRECT_URL="postgresql://user:pass@localhost:5432/anjez?schema=public"

# سرّ توقيع الجلسات — ولّده بـ: openssl rand -base64 48
AUTH_SECRET=""

# العنوان العام للموقع (يُستخدم في روابط الإحالة وروابط العودة من الدفع)
NEXT_PUBLIC_SITE_URL="https://example.com"

# بوّابة الدفع:
#   mock    — صفحة دفع وهمية للتطوير المحلي فقط
#   manual  — تحويل بنكي: العميل يحوّل، والإدارة تؤكّد الاستلام (للتشغيل قبل اعتماد بوّابة)
#   moyasar — دفع إلكتروني حقيقي
PAYMENT_PROVIDER="mock"
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# يسمح بمحاكاة الدفع في الإنتاج — اتركه فارغًا دائمًا في موقع حقيقي
ALLOW_MOCK_PAYMENTS=""

# سرّ استدعاء مهمّة اعتماد العمولات المستحقّة عبر /api/cron/commissions
CRON_SECRET=""

# بيانات أول حساب أدمن عند تشغيل البذور
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
