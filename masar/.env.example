# مفتاح Anthropic — إلزامي. من https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# النموذج. الافتراضي claude-opus-5 وهو الأقوى في التحليل وإعادة الكتابة.
# للتخفيف من التكلفة: claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-5

# عمق التفكير: low | medium | high | xhigh | max
# high متوازن. medium أرخص وأسرع، وجودته كافية لأغلب السير الذاتية.
ANTHROPIC_EFFORT=high

# سقف مخرجات الطلب الواحد. إعادة كتابة السيرة كاملةً تحتاج سقفًا مرتفعًا،
# والتفكير يُحتسب ضمن هذا السقف في claude-opus-5.
ANTHROPIC_MAX_OUTPUT_TOKENS=32000
